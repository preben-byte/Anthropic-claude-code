# Copy this file to .env.local and fill in values there.
# .env.local is gitignored and must never be committed.
# Do NOT paste API keys into chat with any assistant.

# ElevenLabs — used by the Voice Lab (Phase 1) for Voice Design and TTS.
# Without it the Voice Lab runs in mock mode.
ELEVENLABS_API_KEY=

# Model gateway (Phase 3) — leave empty until Phase 3 starts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# PostgreSQL / Redis (Phase 4) — leave empty until Phase 4 starts.
DATABASE_URL=
REDIS_URL=
